# Local Docker Compose defaults. Copy this file to .env only when overriding them.
POSTGRES_USER="pulsehook"
POSTGRES_PASSWORD="pulsehook_dev_password"
POSTGRES_DB="pulsehook"
DATABASE_URL="postgresql://pulsehook:pulsehook_dev_password@postgres:5432/pulsehook"

# The compose default is production; replace this development-only secret before deployment.
FLASK_ENV="production"
AUTH_TOKEN_SECRET="local-dev-change-this-secret-in-production"
APP_BASE_URL="http://localhost:3000"
# Optional comma-separated browser origins allowed for CORS/CSRF (APP_BASE_URL is always included).
CORS_ORIGINS="http://localhost:3000"
ALLOW_REGISTRATION="true"

# Optional OTP email delivery. Leave the key empty to disable Resend locally.
RESEND_API_KEY=""
RESEND_FROM="PulseHook <noreply@example.com>"

# Optional static API key and the verified user ID that owns it.
API_KEY=""
API_KEY_USER_ID=""

# Empty QSTASH_TOKEN uses the built-in APScheduler; set it for Upstash QStash v2 scheduling.
QSTASH_URL="https://qstash.upstash.io"
QSTASH_TOKEN=""
QSTASH_MAX_RETRIES="3"
QSTASH_LOG_SYNC_TTL_SECONDS="15"

# Optional QStash keep-alive ping schedule (override the default health endpoint if needed).
VPS_KEEPALIVE_CRON=""
VPS_KEEPALIVE_URL=""
VPS_KEEPALIVE_BEARER_TOKEN=""

# Production Cloudflare Tunnel only: uncomment COMPOSE_PROFILES and provide the tunnel token.
# COMPOSE_PROFILES="tunnel"
CLOUDFLARE_TUNNEL_TOKEN=""
