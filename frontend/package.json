{
  "name": "pulsehook-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "clean": "rm -rf .next dist",
    "lint": "eslint . && tsc --noEmit",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"*.{json,mjs,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"*.{json,mjs,ts}\"",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "check": "npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "croner": "^11.0.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^16.4.6",
    "postcss": "^8.5.33",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
